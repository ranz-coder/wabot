### Neoxr API : https://api.neoxr.my.id
API_ENDPOINT = 'https://api.neoxr.my.id/api'
API_KEY = ''

### Timezone (Important)
TZ = 'Asia/Jakarta'

### Database (Mongo, PostgreSQL, MySQL, Redis) — leave empty for local (JSON)
DATABASE_URL = ''

### Message Store (Mongo, PostgreSQL, MySQL, Redis) — leave empty for local (JSON) or 'sqlite' for local (Sqlite)
USE_STORE = ''